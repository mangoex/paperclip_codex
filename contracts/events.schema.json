{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://humanio.digital/contracts/events.schema.json",
  "title": "Humanio Operating Event",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "event_type",
    "source",
    "idempotency_key",
    "occurred_at",
    "payload"
  ],
  "properties": {
    "event_type": {
      "type": "string",
      "minLength": 3,
      "maxLength": 120,
      "pattern": "^[a-z][a-z0-9_\\.:-]*$",
      "examples": [
        "prospect.qualified",
        "outreach.sent",
        "reply.interested",
        "demo.requested",
        "proposal.published",
        "handoff.opened"
      ]
    },
    "source": {
      "type": "string",
      "minLength": 2,
      "maxLength": 80,
      "examples": [
        "n8n",
        "whatsapp",
        "chatwoot",
        "surge",
        "manual"
      ]
    },
    "idempotency_key": {
      "type": "string",
      "minLength": 8,
      "maxLength": 200
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time"
    },
    "actor": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 120
    },
    "contact_id": {
      "type": [
        "string",
        "null"
      ],
      "format": "uuid"
    },
    "prospect_id": {
      "type": [
        "string",
        "null"
      ],
      "format": "uuid"
    },
    "summary": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 500
    },
    "payload": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "environment": {
          "type": "string",
          "enum": [
            "local",
            "staging",
            "production"
          ]
        },
        "external_ids": {
          "type": "object",
          "additionalProperties": {
            "type": [
              "string",
              "number",
              "boolean",
              "null"
            ]
          }
        },
        "channel": {
          "type": "string",
          "enum": [
            "whatsapp",
            "email",
            "chatwoot",
            "manual",
            "web"
          ]
        },
        "status": {
          "type": "string",
          "maxLength": 80
        },
        "business_name": {
          "type": "string",
          "maxLength": 200
        },
        "package": {
          "type": "string",
          "enum": [
            "Starter",
            "Pro",
            "Business"
          ]
        },
        "score": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10
        },
        "url": {
          "type": "string",
          "format": "uri",
          "maxLength": 500
        }
      }
    }
  }
}
